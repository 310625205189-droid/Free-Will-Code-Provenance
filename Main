    <script>
        // DATABASE CONTROLLER (Using localStorage as the Database)
        const db = {
            // Register a new user
            register: () => {
                const newUser = {
                    username: document.getElementById('r-username').value,
                    email: document.getElementById('r-email').value.toLowerCase(), // Case-insensitive
                    password: document.getElementById('r-pass').value,
                    phone: document.getElementById('r-phone').value,
                    gender: document.getElementById('r-gender').value,
                    dob: document.getElementById('r-dob').value,
                    city: document.getElementById('r-city').value,
                    institution: document.getElementById('r-inst').value
                };

                if (!newUser.email || !newUser.password) return alert("Email and Password required");

                // Get existing users or create empty list
                let users = JSON.parse(localStorage.getItem('iet_users')) || [];

                // Check if user exists
                if (users.some(u => u.email === newUser.email)) {
                    document.getElementById('reg-error').style.display = 'block';
                    return;
                }

                // Save to Database
                users.push(newUser);
                localStorage.setItem('iet_users', JSON.stringify(users));
                
                alert("Registration Successful!");
                toggleView('login-box');
            },

            // Login user
            login: () => {
                const emailInput = document.getElementById('l-email').value.toLowerCase();
                const passInput = document.getElementById('l-pass').value;
                const users = JSON.parse(localStorage.getItem('iet_users')) || [];

                // Search database
                const foundUser = users.find(u => u.email === emailInput && u.password === passInput);

                if (foundUser) {
                    sessionStorage.setItem('activeUser', JSON.stringify(foundUser));
                    showApp();
                } else {
                    document.getElementById('login-error').style.display = 'block';
                }
            }
        };

        function toggleView(viewId) {
            document.getElementById('login-box').style.display = 'none';
            document.getElementById('reg-box').style.display = 'none';
            document.getElementById(viewId).style.display = 'block';
        }

        function showApp() {
            const user = JSON.parse(sessionStorage.getItem('activeUser'));
            document.getElementById('auth-section').style.display = 'none';
            document.getElementById('app-shell').style.display = 'grid';

            // Display stored database details in the profile
            document.getElementById('user-profile-data').innerHTML = `
                <h2 style="margin-bottom:15px; color:var(--primary)">${user.username}</h2>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                    <p><b>Email:</b> ${user.email}</p>
                    <p><b>Phone:</b> ${user.phone}</p>
                    <p><b>Date of Birth:</b> ${user.dob}</p>
                    <p><b>Gender:</b> ${user.gender}</p>
                    <p><b>City:</b> ${user.city}</p>
                    <p><b>Institution:</b> ${user.institution}</p>
                </div>
            `;
        }

        // Keep logged in on refresh
        window.onload = () => {
            if (sessionStorage.getItem('activeUser')) showApp();
        };
    </script>
