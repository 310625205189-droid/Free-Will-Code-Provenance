    <script>
        function login() {
            const user = document.getElementById('username').value.toLowerCase();
            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('app-shell').style.display = 'grid';
            
            if (user === 'admin') {
                document.getElementById('admin-nav').style.display = 'block';
                document.getElementById('member-nav').style.display = 'none';
                document.getElementById('user-display').innerText = 'Admin User';
                showPage('adm-dash');
            } else {
                document.getElementById('admin-nav').style.display = 'none';
                document.getElementById('member-nav').style.display = 'block';
                document.getElementById('user-display').innerText = 'Member User';
                showPage('mem-dash');
            }
        }

        function logout() {
            document.getElementById('login-screen').style.display = 'flex';
            document.getElementById('app-shell').style.display = 'none';
        }

        function showPage(pageId, navItem) {
            // Hide all sections
            const sections = document.querySelectorAll('.page-section');
            sections.forEach(s => s.classList.remove('active-section'));

            // Show selected section
            document.getElementById(pageId).classList.add('active-section');

            // Update sidebar active state
            const navItems = document.querySelectorAll('nav ul li');
            navItems.forEach(item => item.classList.remove('active'));
            if(navItem) navItem.classList.add('active');

            // Update Header Title
            const titles = {
                'mem-dash': 'Member Dashboard',
                'mem-events': 'Events Explorer',
                'mem-myevents': 'My Registrations',
                'mem-projects': 'Collaborations',
                'mem-profile': 'User Settings',
                'adm-dash': 'System Overview',
                'adm-members': 'Directory Management',
                'adm-events': 'Global Events',
                'adm-projects': 'Global Projects'
            };
            document.getElementById('current-view-title').innerText = titles[pageId] || 'IET Connect';
        }
    </script>
